# Локальная демонстрация. Никогда не используйте этот пароль в production.
NOX_MODE=demo
NOX_DATABASE_URL=postgresql+asyncpg://nox:nox-local@postgres:5432/nox
NOX_REDIS_URL=redis://redis:6379/0
POSTGRES_USER=nox
POSTGRES_PASSWORD=nox-local
POSTGRES_DB=nox
# Секрет BotFather передаётся через окружение/secret manager, не через Git.
NOX_BOT_TOKEN=
# Production: случайная строка >=32 символов, только URL-safe символы Telegram.
NOX_WEBHOOK_SECRET=
# JSON-массив origin Mini App. Production допускает только HTTPS.
NOX_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
